# Скопируй в .env и заполни. Обязателен только BOT_TOKEN.

# --- Telegram -------------------------------------------------------------
BOT_TOKEN=123456789:replace-with-token-from-BotFather
BOT_NAME=Trending
# Знак перед названием в меню (самый похожий на логотип символ; можно заменить на любой)
BRAND_ICON=✾
# Свой эмодзи-логотип вместо знака (номер даст команда /emoji имя_пака). Работает, только если
# у бота есть купленное имя на Fragment — иначе бот сам покажет BRAND_ICON
BRAND_EMOJI_ID=
BRAND_EMOJI_ALT=✨
# Ссылки в разделе «Помощь» (необязательно): кнопка «💬 Поддержка» и «Правила использования»
SUPPORT_URL=
RULES_URL=
# Оформление ответа: card — картинка с цифрами + живой текст (подробный отчёт по кнопке),
# text — построчный отчёт одним сообщением
REPORT_STYLE=card
# Ответ ИИ идёт в чат прямо по мере генерации, шаблонный — плавно «печатается» (false — сразу целиком)
STREAM_ANSWERS=true
STREAM_INTERVAL=0.7
# Плавные черновики Telegram в личке. Карточка появляется, когда ответ готов.
STREAM_DRAFTS=true
DRAFT_INTERVAL=0.25
# Часовой пояс для времени на картинках (например, Europe/Kyiv, Europe/Moscow)
TIMEZONE=UTC
# ID админов через запятую: безлимитный запас и команда /stats
ADMIN_IDS=

# --- Лимиты ----------------------------------------------------------------
DAILY_LIMIT=25
MAX_SKILLS=20
MAX_WATCHES=20
TRENDING_HOURS=12
WATCH_INTERVAL=60
# Слежка за важными новостями по монете и листингами Binance/Bybit — раз в N секунд
NEWS_WATCH_INTERVAL=300
# Новостные Telegram-каналы (публичные, читаются через t.me/s — без ключа), через запятую.
# Пусто — набор по умолчанию: binance_announcements, wublockchainenglish, cointelegraph,
# WatcherGuru, forklog, incrypted. Админ может добавлять и убирать каналы в боте: /channels
NEWS_TG_CHANNELS=
# «🔔 Присылать новые токены на DEX» — скан свежих пулов со скам-чеком раз в N секунд
DEX_WATCH_INTERVAL=180

# --- ИИ-вывод (Claude) -----------------------------------------------------
# Без ключа бот работает: вывод по простым правилам, встроенные навыки считаются, свои — нет.
# Ключ: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Модель задаётся как «claude-opus-5-5» или «провайдер:модель»:
#   openai:<модель> · deepseek:<модель> · xai:<модель> · mistral:<модель> · gemini:<модель>
#   groq:<модель> · openrouter:<автор>/<модель> · ollama:<модель> · custom:<модель>
# auto — выбор модели по задаче из подключённых провайдеров; можно закрепить модель вручную
LLM_MODEL=auto
# low | medium | high | xhigh | max (действует для Claude)
LLM_EFFORT=medium
# Тот же вопрос (те же монеты и навыки) в течение N секунд — готовый ответ ИИ без новых вызовов.
# Экономит деньги, когда много людей спрашивают одно и то же. 0 — выключить
AI_CACHE_SECONDS=180
# Кто читает скриншоты графиков (нужна модель, которая видит картинки: Claude, GPT, Gemini).
# Пусто — главный аналитик (LLM_MODEL). Например, если LLM_MODEL=deepseek:…, укажи gemini:<модель>
VISION_MODEL=

# --- Рой агентов ------------------------------------------------------------
# Рой — 5 специалистов (трейдер, деривативщик, ончейн, новости, риск) + главный аналитик.
# auto (или swarm) — рой только на сложные вопросы: «подробно», сравнение, проверка токена,
#   свой навык, «стоит ли покупать», длинный вопрос; на простой «разбери BTC» — один аналитик
# always — рой на каждый вопрос (до 6 вызовов ИИ на разбор)
# single — только главный аналитик
AI_MODE=auto
# Модель агентов по умолчанию (дешёвая и быстрая)
SWARM_AGENT_MODEL=claude-haiku-5-5
SWARM_AGENT_EFFORT=low
SWARM_AGENT_TIMEOUT=45
# Запасная модель, если агент не ответил (например, deepseek:deepseek-chat)
SWARM_FALLBACK_MODEL=
# Своя модель для отдельной роли — так в одном рое можно смешать разные ИИ
SWARM_MODEL_MARKET=
SWARM_MODEL_DERIVATIVES=
SWARM_MODEL_ONCHAIN=
SWARM_MODEL_NEWS=
SWARM_MODEL_RISK=

# --- Ключи других ИИ-провайдеров (нужны, только если указал их модели выше) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://console.x.ai
XAI_API_KEY=
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://aistudio.google.com/apikey (есть бесплатный лимит)
GEMINI_API_KEY=
# https://console.groq.com/keys (есть бесплатный лимит)
GROQ_API_KEY=
# https://openrouter.ai/settings/keys (один ключ — модели многих провайдеров)
OPENROUTER_API_KEY=
# Локальные модели: Ollama (по умолчанию http://localhost:11434/v1) или любой OpenAI-совместимый сервер
OLLAMA_BASE_URL=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# --- Источники -------------------------------------------------------------
SOURCE_TIMEOUT=8
COLLECT_DEADLINE=15
# Выключить отдельные источники (id из docs/SOURCES.md), через запятую
DISABLED_SOURCES=
# Сломанные источники бот ставит на паузу сам: после SOURCE_FAIL_LIMIT ошибок подряд
# (401/403 — после 2), пауза SOURCE_PAUSE_MINUTES, каждая следующая подряд — вдвое длиннее,
# но не дольше SOURCE_PAUSE_MAX_HOURS. После паузы — пробный запрос. Состояние — /health (для админов)
SOURCE_FAIL_LIMIT=5
SOURCE_PAUSE_MINUTES=30
SOURCE_PAUSE_MAX_HOURS=6
# Раз в сутки присылать админам сводку о сломанных источниках
HEALTH_REPORT=true

# --- Необязательный ключ: поднимает лимиты ------------------------------------
# Бесплатный Demo-ключ: https://www.coingecko.com/en/api/pricing → Create Demo Account
COINGECKO_API_KEY=

# --- Ключи источников, которые уже подключены и включатся сами при наличии ключа ---
# Бесплатные тарифы:
# https://pro.coinmarketcap.com/signup (Basic)
CMC_API_KEY=
# https://pro.coincap.io/dashboard
COINCAP_API_KEY=
# https://www.livecoinwatch.com/tools/api
LIVECOINWATCH_API_KEY=
# https://developers.coinranking.com/create-account
COINRANKING_API_KEY=
# https://openapi.coinstats.app
COINSTATS_API_KEY=
# https://bds.birdeye.so (Security → Generate Key)
BIRDEYE_API_KEY=
# https://etherscan.io/myapikey (один ключ на большинство EVM-сетей)
ETHERSCAN_API_KEY=
# https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
# Платные (бесплатного доступа нет или он не для сервера):
# https://developers.coindesk.com — бесплатный API закрыт с 21.05.2026
CRYPTOCOMPARE_API_KEY=
# https://lunarcrush.com/pricing — бесплатно только рыночные данные
LUNARCRUSH_API_KEY=
# https://newsapi.org/register — бесплатный план только для разработки
NEWSAPI_KEY=
# https://newsdata.io/register — бесплатно 200 запросов в сутки, новости по монете
NEWSDATA_API_KEY=
# https://finnhub.io/register — бесплатно, общая лента крипто-новостей (Reuters, CNBC…)
FINNHUB_API_KEY=
# https://gnews.io/register — бесплатно 100 запросов в сутки, только некоммерческое использование
GNEWS_API_KEY=
# X (Twitter) — бесплатного чтения нет, нужен один из двух ключей:
# https://developer.x.com/en/portal/dashboard — официальный X API (платный), Bearer Token
X_BEARER_TOKEN=
# https://twitterapi.io — сторонний сервис, оплата за объём (не официальный API X)
TWITTERAPI_IO_KEY=
# Какие аккаунты X читать, через запятую. Пусто — крупные новостные и ончейн-аккаунты
NEWS_X_ACCOUNTS=
# https://www.coinglass.com/pricing — ликвидации по всем крупным биржам (от ~$29/мес)
# (без ключа навык «ликвидации» берёт последние ликвидации OKX)
COINGLASS_API_KEY=
# https://tokenomist.ai — расписание разлоков токенов (платно, пробный период по запросу)
TOKENOMIST_API_KEY=
# https://whale-alert.io — крупные переводы китов (тарифы — на сайте)
WHALE_ALERT_API_KEY=

# --- Общее -----------------------------------------------------------------
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
