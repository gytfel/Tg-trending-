# Скопируй в .env и заполни. Обязателен только BOT_TOKEN.

# --- Telegram -------------------------------------------------------------
BOT_TOKEN=123456789:replace-with-token-from-BotFather
BOT_NAME=Trending
# ID админов через запятую: безлимитный запас и команда /stats
ADMIN_IDS=

# --- Лимиты ----------------------------------------------------------------
DAILY_LIMIT=25
MAX_SKILLS=20
MAX_WATCHES=20
TRENDING_HOURS=12
WATCH_INTERVAL=60

# --- ИИ-вывод (Claude) -----------------------------------------------------
# Без ключа бот работает, но вывод строится по простым правилам, а навыки не применяются.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium

# --- Источники -------------------------------------------------------------
SOURCE_TIMEOUT=8
COLLECT_DEADLINE=15
# Выключить отдельные источники (id из docs/SOURCES.md), через запятую
DISABLED_SOURCES=

# --- Необязательные ключи: поднимают лимиты ------------------------------------
COINGECKO_API_KEY=
CRYPTOCOMPARE_API_KEY=

# --- Ключи источников, которые уже подключены и включатся сами при наличии ключа ---
CMC_API_KEY=
COINCAP_API_KEY=
LIVECOINWATCH_API_KEY=
COINRANKING_API_KEY=
COINSTATS_API_KEY=
BIRDEYE_API_KEY=
ETHERSCAN_API_KEY=
LUNARCRUSH_API_KEY=
NEWSAPI_KEY=
CRYPTOPANIC_API_KEY=
FRED_API_KEY=

# --- Общее -----------------------------------------------------------------
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
